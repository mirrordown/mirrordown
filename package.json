{
  "name": "@mirrordown/markdown",
  "private": true,
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": "git@github.com:mirrordown/mirrordown.git",
  "workspaces": [
    "docs",
    "extensions/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config"
