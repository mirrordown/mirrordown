        "deno": true,
        "bun": true,
        "browser": true,
        "workerd": true
      }
    }
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@saeris/configs": "^1.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@varlock/bumpy": "^1.15.0",
    "@vitest/browser-playwright": "catalog:",
    "@vscode/vsce": "^3.9.2",
    "markdown-it": "^14.2.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "catalog:",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satteri": "catalog:",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite-plus": "catalog:",
