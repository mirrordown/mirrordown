  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "@astrojs/markdown-satteri/satteri": "^0.11.5"
  },
  "packageManager": "yarn@4.17.0"
}
