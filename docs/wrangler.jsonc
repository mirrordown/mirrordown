// The docs site on Cloudflare Workers: a static site, so there is no Worker script, only the files Astro builds into `dist`. Workers Builds runs from this folder (its root directory is `docs`): `yarn build:site` builds the packages and the site, then `yarn wrangler deploy` uploads it.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Must be the Worker's name in the Cloudflare dashboard, or Workers Builds refuses the deploy.
  "name": "mirrordown",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist"
  }
}
