{
  "name": "@mirrordown/sat-inline-svg",
  "description": "A Sätteri plugin for inlining referenced .svg images directly into the document as <svg> elements.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@mirrordown/core": "workspace:^",
    "svgo": "catalog:"
  },
  "devDependencies": {
    "satteri": "catalog:"
  },
  "peerDependencies": {
    "satteri": "^0.10.5 || ^0.11.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  },
  "fledgling": {
    "jsr": {
      "runtimeCompat": {
        "node": true,
        "deno": true,
        "bun": true,
        "browser": false,
        "workerd": false
      }
    }
  }
}
