{
  "name": "@mirrordown/mdit-prompt",
  "description": "A markdown-it plugin to render prompt code fences as AI prompts readers can copy or open in Claude, ChatGPT and other services, previewed as the page renders markdown and collapsed by default, that read as plain text where the plugin is not installed.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "style": "./dist/prompt.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./styles": {
      "development": "./src/prompt.css",
      "default": "./dist/prompt.css"
    }
  },
  "dependencies": {
    "@mirrordown/core": "workspace:^"
  },
  "devDependencies": {
    "@types/markdown-it": "catalog:",
    "markdown-it": "catalog:"
  },
  "peerDependencies": {
    "markdown-it": "^14.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  }
}
