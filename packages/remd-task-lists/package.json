{
  "name": "@mirrordown/remd-task-lists",
  "description": "A remark plugin for task lists: GFM's [ ] and [x], plus the six task markers Obsidian's community agrees on ([/], [-], [>], [<], [?], [!]), each labelled and drawn with an icon.",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.css": "./dist/*.css"
  },
  "dependencies": {
    "@mirrordown/core": "workspace:^",
    "mdast-util-to-hast": "^13.0.0",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "unified": "catalog:"
  },
  "peerDependencies": {
    "unified": "^11.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  },
  "style": "./dist/task-lists.css"
}
