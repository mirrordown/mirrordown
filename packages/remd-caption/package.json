{
  "name": "@mirrordown/remd-caption",
  "description": "A remark plugin to caption any block with a ~: line after it, wrapping it in <figure> with a <figcaption>.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "style": "./dist/caption.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.css": "./dist/*.css"
  },
  "dependencies": {
    "@mirrordown/core": "workspace:^"
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "unified": "catalog:",
    "vfile": "^6.0.3"
  },
  "peerDependencies": {
    "unified": "^11.0.0",
    "vfile": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  }
}
