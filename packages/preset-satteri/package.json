{
  "name": "@mirrordown/preset-satteri",
  "description": "The Mirrordown suite for Sätteri in one call.",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.css": "./dist/*.css"
  },
  "dependencies": {
    "@mirrordown/sat-abbr": "workspace:^",
    "@mirrordown/sat-autolink-headings": "workspace:^",
    "@mirrordown/sat-del": "workspace:^",
    "@mirrordown/sat-github-alerts": "workspace:^",
    "@mirrordown/sat-ins": "workspace:^",
    "@mirrordown/sat-kbd": "workspace:^",
    "@mirrordown/sat-lightbox": "workspace:^",
    "@mirrordown/sat-mark": "workspace:^",
    "@mirrordown/sat-ruby": "workspace:^",
    "@mirrordown/sat-sectionize": "workspace:^",
    "@mirrordown/sat-slug": "workspace:^",
    "@mirrordown/sat-spoiler": "workspace:^",
    "@mirrordown/sat-squeeze-paragraphs": "workspace:^",
    "@mirrordown/sat-unwrap-images": "workspace:^"
  },
  "devDependencies": {
    "satteri": "catalog:"
  },
  "peerDependencies": {
    "satteri": "^0.10.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  }
}
