{
  "name": "@mirrordown/sat-prompt",
  "description": "A Sätteri plugin pair to render prompt code fences as AI prompts readers can copy or open in Claude, ChatGPT and other services, previewed as the page renders markdown and collapsed by default, that read as plain text where the plugins are not installed.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrordown/mirrordown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./*.css": "./dist/*.css"
  },
  "dependencies": {
    "@mirrordown/core": "workspace:^"
  },
  "devDependencies": {
    "satteri": "catalog:"
  },
  "peerDependencies": {
    "satteri": "^0.11.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bumpy": {
    "publishCommand": [
      "node ../../scripts/sync-jsr-version.mjs",
      "node ../../scripts/npm-publish.mjs",
      "node ../../scripts/jsr-resolve-deps.mjs",
      "node ../../scripts/jsr-publish.mjs"
    ]
  }
}
